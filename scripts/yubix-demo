#!/bin/sh
# Launch Yubix in fake-root demo mode: your real security key is used, but
# every file change stays inside a throwaway sandbox — nothing real is touched.
# Safe to run over and over; each launch starts from a fresh sandbox.
set -eu

REPO=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
FR="${YUBIX_DEMO_ROOT:-$HOME/yubix-fakeroot}"

# Fresh sandbox each launch keeps the demo deterministic.
rm -rf "$FR"
mkdir -p "$FR/etc/pam.d" "$FR/usr/lib/pam.d" "$FR/var/lib/yubix" "$FR/etc/systemd/system"

# Mirror each service from whichever directory really holds it. Distros split
# these differently -- sddm and sudo are package-owned files in /etc/pam.d,
# while polkit-1, kde and plasmalogin are /usr/lib vendor files -- and the demo
# only exercises the real code paths if the sandbox reproduces that split.
for f in sudo polkit-1 kde plasmalogin sddm; do
    if [ -f "/etc/pam.d/$f" ]; then
        cp "/etc/pam.d/$f" "$FR/etc/pam.d/$f"
    fi
    if [ -f "/usr/lib/pam.d/$f" ]; then
        cp "/usr/lib/pam.d/$f" "$FR/usr/lib/pam.d/$f"
    fi
done

# The login surface is resolved from the display-manager alias; without it the
# helper falls back to probing and can land on a service this machine does not
# actually use (on a stock EndeavourOS box that means the login screen shows up
# as unavailable even though sddm is right there).
DM_LINK=/etc/systemd/system/display-manager.service
if [ -L "$DM_LINK" ]; then
    ln -sf "$(readlink "$DM_LINK")" "$FR$DM_LINK"
fi

HELPER="$REPO/src/Yubix.Helper/bin/Debug/net10.0/yubix-helper"
APP="$REPO/src/Yubix.App/bin/Debug/net10.0/yubix"
if [ ! -x "$HELPER" ] || [ ! -x "$APP" ]; then
    (cd "$REPO" && dotnet build --nologo)
fi

# A stale helper would keep serving an old sandbox path on the session bus.
# -x, not -f: pkill -f would match this very script's command line too.
pkill -x yubix-helper 2>/dev/null || true

YUBIX_ROOT="$FR" "$HELPER" &
HELPER_PID=$!
trap 'kill "$HELPER_PID" 2>/dev/null || true' EXIT INT TERM
sleep 1
YUBIX_ROOT="$FR" "$APP"
