#!/bin/sh
# yubix-restore — replay a Yubix backup manifest and undo PAM changes.
# Zero dependencies beyond POSIX sh + coreutils, so it works from a TTY or
# emergency shell even when the desktop, D-Bus, or the .NET runtime is broken.
#
# Usage:
#   yubix-restore --failsafe        revert an unconfirmed apply (boot failsafe)
#   yubix-restore --last            revert the most recent backup manifest
#   yubix-restore --strip           remove every Yubix PAM line/override (uninstall)
#   yubix-restore <manifest.txt>    revert a specific manifest
set -u

STATE_DIR="${YUBIX_ROOT:-}/var/lib/yubix"
FLAG="$STATE_DIR/pending-apply"

# The exact shape of a line Yubix manages — must stay in sync with
# PamGenerator.ManagedLineRegex.
MARKER_RE='^[[:space:]]*auth[[:space:]]+(sufficient|required)[[:space:]]+pam_u2f\.so[[:space:]].*#[[:space:]]*yubix[[:space:]]*$'

case "${1:-}" in
    --failsafe)
        [ -f "$FLAG" ] || exit 0
        MANIFEST=$(sed -n 's/^manifest=//p' "$FLAG")
        ;;
    --last)
        MANIFEST=$(ls -1t "$STATE_DIR"/backups/*/manifest.txt 2>/dev/null | head -n1)
        ;;
    --strip)
        # Uninstall path (also the pamcheck self-heal when pam_u2f.so is
        # gone): delete overrides Yubix created, strip Yubix marker lines
        # from files it edited. Snapshot-driven when available; falls back
        # to scanning /etc/pam.d. Enrolled key data is left untouched.
        SNAP="$STATE_DIR/pamcheck.snapshot"
        strip_file() {
            f="$1"
            grep -Eq "$MARKER_RE" -- "$f" || return 0
            tmp="$f.yubix-strip.$$"
            grep -Ev "$MARKER_RE" -- "$f" > "$tmp" || true
            cat -- "$tmp" > "$f" && echo "  stripped $f"
            rm -f -- "$tmp"
        }
        if [ -f "$SNAP" ]; then
            while IFS="	" read -r svc mode created etc gsha vendor vsha vexisted; do
                case "$svc" in ""|\#*) continue ;; esac
                [ -f "$etc" ] || continue
                if [ "$created" = "1" ]; then
                    rm -f -- "$etc" && echo "  removed $etc"
                else
                    strip_file "$etc"
                fi
            done < "$SNAP"
            rm -f -- "$SNAP"
        else
            for f in "${YUBIX_ROOT:-}"/etc/pam.d/*; do
                [ -f "$f" ] && strip_file "$f"
            done
        fi
        echo "yubix-restore: Yubix PAM lines removed — password authentication everywhere"
        exit 0
        ;;
    "")
        echo "usage: yubix-restore --failsafe | --last | --strip | <manifest.txt>" >&2
        exit 2
        ;;
    *)
        MANIFEST="$1"
        ;;
esac

if [ -z "${MANIFEST:-}" ] || [ ! -f "$MANIFEST" ]; then
    echo "yubix-restore: no manifest found" >&2
    exit 1
fi

echo "yubix-restore: replaying $MANIFEST"
FAIL=0
while IFS="	" read -r op dest backup; do
    case "$op" in
        restore)
            if cp -a -- "$backup" "$dest"; then
                echo "  restored $dest"
            else
                echo "  FAILED to restore $dest" >&2
                FAIL=1
            fi
            ;;
        delete)
            if rm -f -- "$dest"; then
                echo "  removed $dest"
            else
                echo "  FAILED to remove $dest" >&2
                FAIL=1
            fi
            ;;
    esac
done < "$MANIFEST"

if [ "$FAIL" -eq 0 ]; then
    # Disarm the boot failsafe only once everything is truly back.
    rm -f -- "$FLAG"
    echo "yubix-restore: done — password authentication restored"
else
    echo "yubix-restore: NOT everything was restored — keeping $FLAG armed so the boot failsafe retries" >&2
fi
exit "$FAIL"
