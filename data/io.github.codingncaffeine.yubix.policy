<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Yubix</vendor>
  <vendor_url>https://github.com/codingncaffeine/yubix</vendor_url>

  <action id="io.github.codingncaffeine.yubix.manage">
    <description>Manage security-key login settings</description>
    <message>Authentication is required to change how your security key is used for login and sudo</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
